<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AutoComposite.Core 的自動化測試（xUnit）。不需要 Windows 或顯示卡：ONNX Runtime 用 CPU 版，
    去背推論以 TestAssets\ 中由 tools\make_test_models.py 產生的極小模型驗證前後處理與介面。
    執行：dotnet test AutoComposite\AutoComposite.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AutoComposite.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- CPU 版原生 ONNX Runtime（版本須與 Core 參考的 Managed 套件一致）。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoComposite.Core\AutoComposite.Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestAssets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
