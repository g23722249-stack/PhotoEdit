<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AI Auto Composite Studio 的核心：影像緩衝區、遮罩、幾何變換、定位、遮擋、色彩、陰影、合成、專案存取、模型管理與 ONNX 去背。
    不依賴 WinForms／System.Drawing／原生影像庫，可在任何平台建置與測試；ONNX Runtime 只參考受控 API，
    原生執行檔由主程式（DirectML 版）或測試專案（CPU 版）提供。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AutoComposite</RootNamespace>
    <AssemblyName>AutoComposite.Core</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
  </ItemGroup>

</Project>
