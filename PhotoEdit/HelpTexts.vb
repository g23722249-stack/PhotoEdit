    Private Sub A(key As String, title As String, text As String, Optional hint As String = "", Optional disabledHint As String = "")
        Table(key) = New HelpTip.Entry With {.Title = title, .Text = text, .Hint = hint, .DisabledHint = disabledHint, .Glyph = _glyph}
    End Sub

    ''' <summary>滑桿列：沒有其他提示時，提示「按兩下數值歸零」。</summary>
    Private Sub Row(key As String, title As String, text As String, Optional hint As String = "", Optional disabledHint As String = "")
        A("row." & key, title, text, If(hint = "", ZeroHint, hint & vbCrLf & ZeroHint), disabledHint)
    End Sub

    ''' <summary><paramref name="key"/> 的說明；沒有時回傳 Nothing。</summary>
    Public Function [Get](key As String) As HelpTip.Entry
        Dim e As HelpTip.Entry = Nothing
        Return If(Table.TryGetValue(key, e), e, Nothing)
    End Function

    ''' <summary>測試用：所有的鍵。</summary>
    Friend ReadOnly Property AllKeys As IEnumerable(Of String)
        Get
            Return Table.Keys
        End Get
    End Property
End Module
