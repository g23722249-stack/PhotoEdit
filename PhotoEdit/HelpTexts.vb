''' <summary>
''' HelpTip 顯示的使用說明，集中在這裡，改文字不必動到畫面程式。
''' 鍵 → 標題、說明、提示（技巧、快捷鍵）、停用提示（為什麼現在不能用）。
''' 鍵的命名：「tab.n」分頁、「row.滑桿鍵」滑桿列、「btn.*」按鈕，其餘依分頁分組；
''' 每組的徽章字樣是分頁名稱的第一個字。找不到的鍵回傳 Nothing（不顯示說明）。
''' </summary>
Friend Module HelpTexts

    Private ReadOnly Table As New Dictionary(Of String, HelpTip.Entry)(StringComparer.OrdinalIgnoreCase)
    Private _glyph As String = ""

    ' 共用的停用提示
    Private Const NeedPhoto As String = "先開啟一張照片。"
    Private Const NeedLocal As String = "先按「＋ 漸層濾鏡」或「＋ 局部筆刷」，或從清單選一個局部調整。"
    Private Const NeedOverlay As String = "先在照片上點選一段文字或一張貼圖。"
    Private Const NeedText As String = "先在照片上點選一段文字，或按「＋ 文字」。"
    Private Const NeedCutout As String = "先按「自動去背」。"
    Private Const ZeroHint As String = "在右邊的數值上按兩下歸零。"

