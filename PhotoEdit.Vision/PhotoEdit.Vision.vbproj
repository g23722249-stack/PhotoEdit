<Project Sdk="Microsoft.NET.Sdk">

  <!-- 用到 OpenCV 的功能：YuNet 人臉偵測、磨皮/提亮/亮眼、污點移除、降噪、自動拉直。
       模型 Models\face_detection_yunet_2023mar.onnx（OpenCV Zoo，Apache-2.0）不放進 git（.gitignore 排除 *.onnx），
       缺檔時人像功能會停用，其他功能照常。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PhotoEdit</RootNamespace>
    <AssemblyName>PhotoEdit.Vision</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20241108" />
    <!-- 去背模型（IS-Net、U²-Net）用 ONNX Runtime 執行：OpenCV DNN 不支援 IS-Net 的部分運算。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoEdit.Core\PhotoEdit.Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- -p:SkipModelCopy=true：模型下載中（檔案被占用）時仍可編譯測試。 -->
    <None Include="Models\*.onnx" CopyToOutputDirectory="PreserveNewest" LinkBase="Models" Condition="'$(SkipModelCopy)' != 'true'" />
    <None Include="Models\*.yaml" CopyToOutputDirectory="PreserveNewest" LinkBase="Models" Condition="'$(SkipModelCopy)' != 'true'" />
    <!-- 宮崎風 AI 重繪的生成模型（約 2.6 GB）：原本的 unet\ 用不到（用加過 ControlNet 輸入的 unet_controlnet\），不複製。 -->
    <None Include="Models\GhibliDiffusion\**\*" Exclude="Models\GhibliDiffusion\unet\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Models\GhibliDiffusion" Condition="'$(SkipModelCopy)' != 'true'" />
    <None Include="Models\AnimeAnything\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Models\AnimeAnything" Condition="'$(SkipModelCopy)' != 'true'" />
    <None Include="AnimeRedrawPresets.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- OpenH264（Cisco，另外下載、不放進 git）：有的話 MP4 用它壓縮（檔案小很多），放在程式資料夾 -->
    <None Include="Native\openh264-*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
